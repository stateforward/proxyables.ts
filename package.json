{
  "name": "proxyables",
  "version": "0.0.1",
  "description": "Web Streams-based object proxy RPC over Yamux.",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "NODE_OPTIONS='--expose-gc' vitest run",
    "bench": "npm run build && node bench/bench.js"
  },
  "author": "StateForward",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stateforward/proxyables.ts.git"
  },
  "bugs": {
    "url": "https://github.com/stateforward/proxyables.ts/issues"
  },
  "homepage": "https://github.com/stateforward/proxyables.ts#readme",
  "devDependencies": {
    "@node-ipc/node-ipc": "^11.0.3",
    "@sinclair/typebox": "^0.33.17",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "comlink": "^4.4.1",
    "pino-caller": "^3.4.0",
    "pino-pretty": "^11.3.0",
    "rpc-websockets": "^4.1.2",
    "source-map-support": "^0.5.21",
    "threads": "^1.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "workerpool": "^6.4.4"
  },
  "dependencies": {
    "@stateforward/yamux.ts": "^0.1.1",
    "@msgpack/msgpack": "^3.0.0-beta2",
    "pino": "^9.5.0"
  }
}
